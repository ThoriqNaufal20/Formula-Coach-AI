# Pilih provider: "groq" (GRATIS, default) | "gemini" (GRATIS) | "anthropic" (berbayar) | "openai" (berbayar)
AI_PROVIDER=groq

# --- GROQ (gratis, tanpa kartu kredit) ---
# Daftar & buat key di: https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx
GROQ_MODEL=openai/gpt-oss-120b

# --- GEMINI (gratis, tanpa kartu kredit) ---
# Daftar & buat key di: https://aistudio.google.com/apikey
# GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxx
# GEMINI_MODEL=gemini-flash-latest

# --- ANTHROPIC / Claude (berbayar, kualitas terbaik) ---
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
# ANTHROPIC_MODEL=claude-sonnet-5

# --- OPENAI (berbayar) ---
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# OPENAI_MODEL=gpt-4o-mini
